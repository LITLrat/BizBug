# Set these in your hosting provider environment. This file is a template only.
# DO NOT commit actual values, OAuth access tokens or Twilio credentials to source control.
DEMO_MODE=false
ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_VALUE
DATABASE_PATH=/data/bizbug.sqlite3
PUBLIC_BASE_URL=https://YOUR-BIZBUG-DOMAIN.com
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# AI replies beyond configured FAQs (optional in demo, required for flexible AI Q&A)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Google Cloud Console OAuth Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra App Registration, web platform, delegated calendar permissions
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Twilio console > Account Info > Auth Token; inbound SMS is via TwiML response.
TWILIO_AUTH_TOKEN=

# Optional origins for direct cross-origin API clients; iframe widget doesn't need this.
ALLOWED_ORIGINS=
